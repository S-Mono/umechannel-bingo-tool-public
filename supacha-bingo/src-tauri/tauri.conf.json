{
  "productName": "supacha-bingo",
  "version": "1.1.0",
  "identifier": "com.supacha.bingo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      { "label": "main", "title": "Bingo Control", "width": 450, "height": 650, "maximizable": false },
      {
        "label": "display",
        "title": "Bingo Display",
        "width": 282,
        "height": 368,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "effect",
        "title": "Bingo Effect",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis":{
        "languages": ["Japanese"], 
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "publisher": "aki缶/UmeChannel",
    "copyright": "Copyright © 2026 aki缶/UmeChannelProject. All rights reserved."
  }
}
